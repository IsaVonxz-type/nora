{
  "name": "nora",
  "version": "2.0.0",
  "description": "Aplicación web para coordinar sedes, espacios compartidos, disponibilidad, reservas y operación, con demo pública de datos sintéticos.",
  "main": "backend/dev-server.js",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "start": "node backend/prod-server.js",
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "nodemon backend/dev-server.js",
    "dev:frontend": "pnpm --dir frontend run dev",
    "build:frontend": "pnpm --dir frontend run build",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed:demo": "node scripts/seed-local-demo.mjs",
    "preview:frontend": "pnpm --dir frontend run preview",
    "test:smoke": "node scripts/smoke-test.mjs",
    "lint": "eslint backend frontend/src frontend/scripts frontend/vite.config.js shared api scripts eslint.config.js --no-inline-config --max-warnings 0",
    "test:integration": "node --test backend/integration/postgres.test.mjs",
    "audit:dependencies": "pnpm audit --audit-level high && pnpm --dir frontend audit --audit-level high",
    "test:backend": "vitest run --config backend/vitest.config.js",
    "test:backend:watch": "vitest --config backend/vitest.config.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "eslint": "10.12.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "24.x"
  }
}
