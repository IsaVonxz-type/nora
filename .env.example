PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require
# Generate a secure secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Minimum 32 characters. Never use a guessable value in production.
JWT_SECRET=
DEFAULT_TENANT_SLUG=default
ENABLE_COMPRESSION=
# Optional host routing. Maps an owned hostname to a tenant slug.
# Example: ORGANIZATION_HOSTS=campus.example.edu=default,espacio.example.edu=demo
# Leave empty to keep path-based organization access.
ORGANIZATION_HOSTS=
# Optional extra hosts that belong to the platform itself (never a tenant).
# CORS_ORIGIN and VERCEL_URL are used automatically; *.vercel.app is always accepted.
PLATFORM_HOSTS=
