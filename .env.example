PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require
# Generate a secure secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Minimum 32 characters. Never use a guessable value in production.
JWT_SECRET=
ENABLE_COMPRESSION=
# Required in production outside Vercel: exact HTTPS origin of the interface.
CORS_ORIGIN=
# Number of trusted reverse proxies in front of Node (for example 1). Leave empty without a proxy.
TRUST_PROXY_HOPS=
